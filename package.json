{
  "name": "default-js-app-cordova",
  "displayName": "Default JS App",
  "version": "1.0.0",
  "description": "Cordova-оболочка для default-js-app: конфиг, ресурсы, хуки и список плагинов",
  "private": true,
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "theZMI <zmigpost@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@red-mobile/cordova-plugin-barcodescanner": "^9.1.0",
    "cordova-android": "^13.0.0",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-audio-output": "file:../default-js-app/native-plugins/cordova-plugin-audio-output",
    "cordova-plugin-background-mode": "0.7.3",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^8.1.0",
    "cordova-plugin-file-opener2": "^4.0.0",
    "cordova-plugin-file-transfer": "^2.0.0",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-plugin-inappbrowser": "^6.0.0"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "@red-mobile/cordova-plugin-barcodescanner": {
        "ANDROIDX_LEGACY_SUPPORT_V4_VERSION": "1.0.0"
      },
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-background-mode": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-device": {},
      "cordova-plugin-file": {},
      "cordova-plugin-file-opener2": {},
      "cordova-plugin-file-transfer": {},
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "false"
      },
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-local-notification": {
        "ANDROIDX_CORE_VERSION": "1.12.0"
      },
      "cordova-plugin-x-socialsharing": {},
      "cordova-plugin-insomnia": {},
      "cordova-plugin-music-controls2": {},
      "cordova-plugin-fingerprint-aio": {},
      "phonegap-nfc": {},
      "cordova-plugin-audio-output": {}
    }
  },
  "dependencies": {
    "cordova-plugin-fingerprint-aio": "6.0.1",
    "cordova-plugin-insomnia": "4.3.0",
    "cordova-plugin-local-notification": "1.2.3",
    "cordova-plugin-music-controls2": "3.0.7",
    "cordova-plugin-x-socialsharing": "6.0.4",
    "es6-promise-plugin": "4.2.2",
    "phonegap-nfc": "1.2.0"
  }
}
